NODE_ENV=development
PORT=3000
# API docs at /api/docs. Set to false in production unless the docs should be public.
SWAGGER_ENABLED=true
# Base URL customers' phones can reach, for shareable receipt links (e.g. https://api.softlife.ng)
PUBLIC_API_URL=http://localhost:3000

# The API and worker connect as two different, deliberately limited roles.
#   softlife_app    -> every tenant query; Row-Level Security confines it to one organization
#   softlife_system -> ONLY auth lookups (login/refresh) and the outbox relay
# In production both go through PgBouncer in *transaction* pooling mode.
DATABASE_APP_URL=postgres://softlife_app:app_dev_password@localhost:5432/softlife
DATABASE_SYSTEM_URL=postgres://softlife_system:system_dev_password@localhost:5432/softlife
DATABASE_POOL_MAX=10

# Migrations run as the table owner and must connect DIRECTLY to Postgres, never through PgBouncer.
DATABASE_MIGRATION_URL=postgres://softlife_owner:owner_dev_password@localhost:5432/softlife

# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret-of-48-plus-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
PIN_SESSION_TTL_HOURS=14

OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10

# ─── Notifications (worker) ──────────────────────────────────────────────────
SCHEDULER_TICK_MS=60000
NOTIFICATION_POLL_INTERVAL_MS=2000
# Push: Firebase console > Project settings > Service accounts > Generate new private key,
# then base64 the JSON file:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))  (PowerShell)
FCM_SERVICE_ACCOUNT_BASE64=
# SMS: termii.com dashboard. Sender IDs must be registered with Termii first.
TERMII_API_KEY=
TERMII_SENDER_ID=SoftLife
TERMII_CHANNEL=dnd

# ─── File storage (exports, delivery signatures) ─────────────────────────────
# local = a folder on this machine (fine for development). s3 = any S3-compatible bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_BUCKET=softlife-files
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
EXPORT_POLL_INTERVAL_MS=3000
